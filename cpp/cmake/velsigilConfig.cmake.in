@PACKAGE_INIT@

# velsigil is a static library: its private dependencies must be available to the final link.
include(CMakeFindDependencyMacro)

find_dependency(Threads)
find_dependency(CURL)

set(_velsigil_sodium_from_pkgconfig @VX_SODIUM_FROM_PKGCONFIG@)
if(_velsigil_sodium_from_pkgconfig)
  find_dependency(PkgConfig)
  if(NOT TARGET PkgConfig::VX_SODIUM)
    pkg_check_modules(VX_SODIUM QUIET IMPORTED_TARGET libsodium)
  endif()
  if(NOT TARGET PkgConfig::VX_SODIUM)
    set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
    set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE "libsodium was not found via pkg-config")
    return()
  endif()
else()
  find_dependency(unofficial-sodium CONFIG)
endif()
unset(_velsigil_sodium_from_pkgconfig)

include("${CMAKE_CURRENT_LIST_DIR}/velsigilTargets.cmake")
check_required_components(velsigil)
