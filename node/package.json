{
  "name": "velsigil-client",
  "version": "1.0.4",
  "description": "Official Node.js client for Velsigil license validation (Ed25519-verified responses, offline leases, device binding)",
  "type": "module",
  "license": "MIT",
  "author": "Velsigil",
  "homepage": "https://github.com/VelSigil/velsigil-sdks/tree/main/node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelSigil/velsigil-sdks.git",
    "directory": "node"
  },
  "bugs": {
    "url": "https://github.com/VelSigil/velsigil-sdks/issues"
  },
  "keywords": [
    "velsigil",
    "license",
    "licensing",
    "license-key",
    "ed25519",
    "offline-lease"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "example": "node examples/basic.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
