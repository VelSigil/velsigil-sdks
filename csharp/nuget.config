<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for the .NET SDK, its tests and the example: nuget.org only, and package source mapping says
  every package id comes from nuget.org. A feed configured on the build machine (user or machine nuget.config) is
  never consulted for these projects, which closes the dependency-confusion path.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
