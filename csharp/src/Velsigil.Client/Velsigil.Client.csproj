<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Velsigil.Client</RootNamespace>
    <AssemblyName>Velsigil.Client</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Every nullable-reference warning is a build error. -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>

    <!-- NuGet package metadata -->
    <PackageId>Velsigil.Client</PackageId>
    <Version>1.0.2</Version>
    <Authors>Velsigil</Authors>
    <Company>Velsigil</Company>
    <Product>Velsigil</Product>
    <Title>Velsigil .NET client</Title>
    <Description>Official .NET client for the Velsigil license server: online validation with Ed25519-signed responses, device secrets, offline leases, update checks and verified downloads.</Description>
    <PackageTags>license;licensing;license-key;activation;ed25519;velsigil</PackageTags>
    <Copyright>Copyright (c) 2026 Velsigil</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/VelSigil/velsigil-sdks/tree/main/csharp</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/VelSigil/velsigil-sdks/blob/main/csharp/CHANGELOG.md</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/VelSigil/velsigil-sdks.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Repository URL + commit in the .nuspec, so the package links back to the exact source it was built from. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <!--
      Source Link: the .NET 8+ SDK ships Microsoft.SourceLink.GitHub (Sdks/Microsoft.SourceLink.GitHub) and enables it
      by default, so the PDBs map every source file to its raw.githubusercontent.com URL at the built commit without a
      package reference. Files generated during the build are embedded in the PDB instead.
    -->
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- CI builds (GitHub Actions) normalise source paths in PDBs and embedded data, so the output does not depend
       on the runner's checkout directory. Local builds keep real paths for debugging. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Velsigil.Client.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <!-- The license is declared by PackageLicenseExpression; the text ships alongside for offline review. -->
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
